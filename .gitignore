# Python bytecode / native extensions
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments / local Python versions
.venv/
venv/
env/
ENV/
.python-version

# Packaging / build output
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Tests / coverage / analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage.json
junit.xml

# Secrets / machine-specific configuration
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
.aws/

# Flask runtime / databases (including SQLite sidecars)
instance/*
!instance/.gitkeep
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Runtime logs / user uploads / backups / local exports
logs/*
!logs/.gitkeep
*.log
uploads/
backups/*
!backups/.gitkeep
exports/
*.bak
*.backup
*.dump

# Frontend dependencies / generated assets, if added later
node_modules/
.npm/
.parcel-cache/
.vite/
app/static/dist/

# IDE / OS / temporary files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.vs/
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
*.tmp
*.temp
.ipynb_checkpoints/

# Local agent state; keep AGENTS.md and shared project docs tracked
.codex/
.agents/

# Keep dependency lockfiles and migration files tracked when introduced.
