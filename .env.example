# Copy to .env; generate your own random SECRET_KEY before starting.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-before-use
DATABASE_URL=sqlite:///chdv.sqlite3
# Relative SQLite URLs are resolved under instance/ by Flask-SQLAlchemy.
COOKIE_SECURE=false
INITIAL_ADMIN_USERNAME=root
INITIAL_ADMIN_PASSWORD=
# Used only by `flask --app wsgi init-admin`. Never commit a real password.
# Set COOKIE_SECURE=true when deploying behind HTTPS.
